{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default Sarca client capabilities",
  "windows": ["main"],
  "remote": {
    "urls": ["http://*", "https://*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "shell:allow-open"
  ]
}
