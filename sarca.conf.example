PORT=8000
WORKERS=4
CHANNEL_CAPACITY=32
SUPERUSER_EMAIL=sarca@sarca.sarca
SUPERUSER_PASS=sarca
ACCESS_TOKEN_EXPIRE_IN_SECS=1800
REFRESH_TOKEN_EXPIRE_IN_DAYS=14
SECRET_KEY=XXX

# --- Telegram integration ---
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Requests per minute per bot (scheduler enforces this via DB)
TELEGRAM_RATE_LIMIT=18

# Chunk size (MB). Official Bot API supports up to 20 MB per document.
# Files larger than this are split into multiple Telegram documents.
TELEGRAM_CHUNK_SIZE_MB=20
TELEGRAM_VIDEO_CHUNK_SIZE_MB=20

# Where Sarca spools uploads before sending to Telegram
WORK_DIR=/work

# Must match compose db service (POSTGRES_*) when using Docker Compose.
DATABASE_USER=sarca
DATABASE_PASSWORD=sarca
DATABASE_NAME=sarca
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Auth: email verify / password reset ---
# Public base URL used in email links
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Leave SMTP_HOST empty to disable outbound mail (verify/reset return "mail not configured")
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Sarca <noreply@example.com>
SMTP_TLS=starttls   # starttls | none | tls
