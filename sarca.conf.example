PORT=8000
WORKERS=4
CHANNEL_CAPACITY=32

# How many thumb/preview/download requests may block on Telegram at once.
# Independent of WORKERS, which only sizes the DB pool.
MEDIA_CONCURRENCY=16
SUPERUSER_EMAIL=sarca@sarca.sarca
SUPERUSER_PASS=sarca
ACCESS_TOKEN_EXPIRE_IN_SECS=1800
REFRESH_TOKEN_EXPIRE_IN_DAYS=14
SECRET_KEY=XXX

# Verbose (debug-level) logging for requests and background jobs. RUST_LOG still overrides this.
DEBUG_LOG=1

# --- Telegram integration ---
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Requests per minute per bot (scheduler enforces this via DB). This is a
# self-imposed safety limit, not a number Telegram publishes for getFile.
TELEGRAM_RATE_LIMIT=60

# Chunk size (MB). Official Bot API supports up to 20 MB per document.
# Files larger than this are split into multiple Telegram documents.
TELEGRAM_CHUNK_SIZE_MB=20
TELEGRAM_VIDEO_CHUNK_SIZE_MB=20

# Where Sarca spools uploads before sending to Telegram
WORK_DIR=/work

# SQLite metadata database (WAL mode). Default: {WORK_DIR}/sarca.sqlite
SQLITE_PATH=/work/sarca.sqlite

# --- TLS / ACME (Let's Encrypt short-lived) ---
# Public domain or IP for certificate identity.
# Unset = the server detects its public IP at startup and uses that.
TLS_HOSTNAME=

# HTTPS listen address (HTTP/3 UDP + TLS TCP). Production: 0.0.0.0:443
HTTPS_ADDR=0.0.0.0:443

# ACME http-01 + redirect to HTTPS. Production: 0.0.0.0:80
ACME_HTTP_ADDR=0.0.0.0:80

# PEM store for ACME account + issued certs. Default: {WORK_DIR}/certs
CERTS_DIR=/work/certs

# ACME directory URL (Let's Encrypt production by default)
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Dev/e2e only: skip TLS and serve plain HTTP on PORT
# SARCA_PLAIN_HTTP=1

# Dev/e2e only: add 'unsafe-eval' to script-src so tauri-pilot can drive the UI.
# Never set this on a real deployment — it removes an XSS barrier.
# SARCA_ALLOW_EVAL=1


# Extra PEM root the ACME client trusts (private CA: step-ca, Pebble). Empty = system store.
#ACME_ROOT_CA=/etc/sarca/acme-ca.pem
