# set superuser
SUPERUSER_EMAIL=sarca@sarca.sarca
SUPERUSER_PASS=sarca
ACCESS_TOKEN_EXPIRE_IN_SECS=1800
REFRESH_TOKEN_EXPIRE_IN_DAYS=14
SECRET_KEY=<YOU-NEED-TO-CHANGE-THIS-STRING>

# --- TLS / ACME (Let's Encrypt short-lived) ---
TLS_HOSTNAME=
HTTPS_ADDR=0.0.0.0:443
ACME_HTTP_ADDR=0.0.0.0:80
CERTS_DIR=/work/certs
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory


WORKERS=4
CHANNEL_CAPACITY=32
MEDIA_CONCURRENCY=4

PREFETCH_ENABLED=true
PREFETCH_DEPTH=3
PREFETCH_CONCURRENCY=3
PREFETCH_MAX_ITEMS=2000
PREFETCH_INTERVAL_SECS=600

# Verbose (debug-level) logging for requests and background jobs. RUST_LOG still overrides this.
DEBUG_LOG=1

# --- Telegram integration ---
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_RATE_LIMIT=60
TELEGRAM_CHUNK_SIZE_MB=20

# Route all Telegram Bot API traffic (uploads, downloads, setup calls) through
# a proxy. Useful when api.telegram.org is blocked or slow to reach directly.
# Accepted schemes: http://, https://, socks5://, socks5h://. Leave blank to
# connect directly (default).
# Prefer socks5h over socks5: socks5h resolves the destination hostname at the
# proxy, so your local resolver never sees api.telegram.org; socks5 resolves
# it locally first and only tunnels the connection afterwards.
# Sarca's TLS session to api.telegram.org is always negotiated end to end —
# certificate verification is never disabled — so the proxy cannot read bot
# tokens or file contents either way. An http:// proxy sees only a
# "CONNECT api.telegram.org:443"; a socks5/socks5h proxy sees only an opaque
# byte stream. Either way it learns the destination host and traffic volume,
# nothing more.
# TELEGRAM_PROXY_URL=socks5h://127.0.0.1:1080

WORK_DIR=/work
SQLITE_PATH=/work/sarca.sqlite
